---
import AppLayout from '../layouts/AppLayout.astro';

const breadcrumbs = [{ label: 'Dashboard' }];
---

<AppLayout title="Dashboard" breadcrumbs={breadcrumbs}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="card p-6">
      <p class="text-sm text-gray-400">Deals Abiertos</p>
      <p class="text-3xl font-bold text-blue-400 mt-2">0</p>
    </div>
    <div class="card p-6">
      <p class="text-sm text-gray-400">Pagado este Mes</p>
      <p class="text-3xl font-bold text-green-400 mt-2">$0</p>
    </div>
    <div class="card p-6">
      <p class="text-sm text-gray-400">Deals Perdidos</p>
      <p class="text-3xl font-bold text-red-400 mt-2">0</p>
    </div>
  </div>
  <div class="card p-6">
    <h2 class="text-lg font-semibold mb-4">Últimos Deals</h2>
    <p class="text-gray-400 text-sm">No hay deals aún. Crea tu primera solicitud en Nueva Solicitud.</p>
  </div>
</AppLayout>
